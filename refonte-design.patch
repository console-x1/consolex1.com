diff -ruN a/src/components/SixSeven.tsx b/src/components/SixSeven.tsx
--- a/src/components/SixSeven.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/SixSeven.tsx	2026-11-24 22:31:00.817936966 +0000
@@ -0,0 +1,144 @@
+'use client';
+
+import { useCallback, useEffect, useMemo, useState, type CSSProperties } from 'react';
+
+const WORDS = ['67', '6 7', '6-7', 'six seven', 'six-seven', 'sixseven'];
+const COLORS = ['text-brand', 'text-accent', 'text-ok', 'text-warn'];
+
+// petit générateur déterministe : le rendu reste pur, la pluie change à chaque déclenchement
+function seeded(seed: number) {
+  let s = seed * 9301 + 49297;
+  return () => {
+    s = (s * 9301 + 49297) % 233280;
+    return s / 233280;
+  };
+}
+
+export default function SixSeven() {
+  const [active, setActive] = useState(false);
+  const [calm, setCalm] = useState(false);
+  const [round, setRound] = useState(0);
+
+  const close = useCallback(() => setActive(false), []);
+
+  useEffect(() => {
+    let typed = '';
+    let sizes: number[] = [];
+    let current = 0;
+    let timer = 0;
+
+    const fire = () => {
+      setCalm(window.matchMedia('(prefers-reduced-motion: reduce)').matches);
+      setRound((r) => r + 1);
+      setActive(true);
+    };
+
+    // Clavier : taper « 67 » ou « six seven » n'importe où sur la page
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        setActive(false);
+        return;
+      }
+      if (e.ctrlKey || e.metaKey || e.altKey || e.key.length !== 1) return;
+      const el = e.target as HTMLElement | null;
+      if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
+      typed = (typed + e.key.toLowerCase()).slice(-12);
+      if (WORDS.some((w) => typed.endsWith(w))) {
+        typed = '';
+        fire();
+      }
+    };
+
+    // Téléphone : 6 appuis rapides, une pause, puis 7 appuis rapides sur la ligne de copyright
+    const onTap = (e: PointerEvent) => {
+      if (!(e.target as Element | null)?.closest?.('[data-six-seven]')) return;
+      current += 1;
+      window.clearTimeout(timer);
+      timer = window.setTimeout(() => {
+        sizes = [...sizes, current].slice(-2);
+        current = 0;
+        if (sizes[0] === 6 && sizes[1] === 7) {
+          sizes = [];
+          fire();
+        }
+      }, 650);
+    };
+
+    window.addEventListener('keydown', onKey);
+    document.addEventListener('pointerup', onTap);
+    return () => {
+      window.removeEventListener('keydown', onKey);
+      document.removeEventListener('pointerup', onTap);
+      window.clearTimeout(timer);
+    };
+  }, []);
+
+  // secousse de la page, fermeture automatique
+  useEffect(() => {
+    if (!active) return;
+    const shell = document.querySelector('[data-shell]');
+    if (!calm) shell?.classList.add('animate-shake');
+    const stopShake = window.setTimeout(() => shell?.classList.remove('animate-shake'), 1400);
+    const autoClose = window.setTimeout(() => setActive(false), 6500);
+    return () => {
+      window.clearTimeout(stopShake);
+      window.clearTimeout(autoClose);
+      shell?.classList.remove('animate-shake');
+    };
+  }, [active, calm, round]);
+
+  const drops = useMemo(() => {
+    const rand = seeded(round + 7);
+    return Array.from({ length: 26 }, (_, i) => ({
+      id: i,
+      left: `${Math.round(rand() * 96)}%`,
+      size: `${(1.4 + rand() * 2.6).toFixed(2)}rem`,
+      delay: `${(rand() * 2.4).toFixed(2)}s`,
+      duration: `${(2.6 + rand() * 2.2).toFixed(2)}s`,
+      rotate: `${Math.round(rand() * 120 - 60)}deg`,
+      color: COLORS[i % COLORS.length],
+    }));
+  }, [round]);
+
+  if (!active) return null;
+
+  return (
+    <div
+      role="dialog"
+      aria-label="six seven"
+      onClick={close}
+      className="fixed inset-0 z-[10000] grid animate-fade-in cursor-pointer place-items-center overflow-hidden bg-page/85 backdrop-blur-sm"
+    >
+      {!calm && (
+        <div aria-hidden="true" className="pointer-events-none absolute inset-0 overflow-hidden">
+          {drops.map((d) => (
+            <span
+              key={d.id}
+              className={`absolute top-0 animate-fall font-display font-bold opacity-0 ${d.color}`}
+              style={
+                {
+                  left: d.left,
+                  fontSize: d.size,
+                  animationDelay: d.delay,
+                  '--fall-d': d.duration,
+                  '--fall-r': d.rotate,
+                } as CSSProperties
+              }
+            >
+              67
+            </span>
+          ))}
+        </div>
+      )}
+
+      <div className="relative px-6 text-center">
+        <div className="flex items-end justify-center gap-4 font-display leading-none font-extrabold sm:gap-10">
+          <span className={`animate-bob-a text-[clamp(7rem,34vw,17rem)] text-brand`}>6</span>
+          <span className="animate-bob-b text-[clamp(7rem,34vw,17rem)] text-accent">7</span>
+        </div>
+        <p className="mt-6 mb-0 font-mono text-sm tracking-[.25em] text-soft uppercase">six seven</p>
+        <p className="mt-2 mb-0 text-xs text-mute">Esc</p>
+      </div>
+    </div>
+  );
+}
diff -ruN a/src/components/StatusBanner.tsx b/src/components/StatusBanner.tsx
--- a/src/components/StatusBanner.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/StatusBanner.tsx	2026-11-24 22:31:00.817483215 +0000
@@ -0,0 +1,90 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+import { STATUS_PAGE, useStatus, type StatusState } from './status';
+
+const WIDGET_SRC = 'https://incidents.betterstack.com/widgets/announcement.js';
+const WIDGET_ID = '262405';
+const STORAGE_KEY = 'status-dismissed';
+
+const copy = {
+  fr: {
+    title: { operational: 'Information', degraded: 'Performances dégradées.', downtime: 'Incident en cours.', maintenance: 'Maintenance.', unknown: '' },
+    link: 'Voir le statut',
+    close: 'Fermer l’annonce',
+  },
+  en: {
+    title: { operational: 'Notice', degraded: 'Degraded performance.', downtime: 'Ongoing incident.', maintenance: 'Maintenance.', unknown: '' },
+    link: 'View status',
+    close: 'Dismiss notice',
+  },
+};
+
+const tones: Record<StatusState, string> = {
+  operational: 'border-brand/40 bg-brand/10 text-brand',
+  maintenance: 'border-brand/40 bg-brand/10 text-brand',
+  degraded: 'border-warn/50 bg-warn/10 text-warn',
+  downtime: 'border-bad/50 bg-bad/10 text-bad',
+  unknown: 'border-line bg-panel text-mute',
+};
+
+export default function StatusBanner({ locale }: { locale: 'fr' | 'en' }) {
+  const { state, announcement, ready, failed } = useStatus();
+  const [dismissed, setDismissed] = useState<string | null>(() => {
+    try {
+      return typeof window === 'undefined' ? null : sessionStorage.getItem(STORAGE_KEY);
+    } catch {
+      return null;
+    }
+  });
+
+  // Si l'API n'est pas lisible depuis le navigateur, on retombe sur le widget officiel Better Stack
+  useEffect(() => {
+    if (!failed || document.querySelector('script[data-betterstack-widget]')) return;
+    const script = document.createElement('script');
+    script.src = WIDGET_SRC;
+    script.async = true;
+    script.dataset.id = WIDGET_ID;
+    script.dataset.betterstackWidget = '';
+    document.body.appendChild(script);
+  }, [failed]);
+
+  const key = `${state}|${announcement ?? ''}`;
+  const hasIssue = state === 'degraded' || state === 'downtime' || state === 'maintenance';
+  if (!ready || failed || (!announcement && !hasIssue) || dismissed === key) return null;
+
+  const t = copy[locale];
+
+  function dismiss() {
+    setDismissed(key);
+    try {
+      sessionStorage.setItem(STORAGE_KEY, key);
+    } catch {
+      /* stockage indisponible : on masque seulement pour cette page */
+    }
+  }
+
+  return (
+    <div
+      role="status"
+      className={`mb-2 flex items-start gap-3 rounded-lg border px-4 py-3 text-[.92rem] leading-[1.5] ${tones[state]}`}
+    >
+      <span aria-hidden="true" className="mt-[.5rem] size-2 shrink-0 rounded-full bg-current" />
+      <p className="m-0 min-w-0 flex-1 text-ink">
+        {t.title[state] && <strong className="font-semibold">{t.title[state]} </strong>}
+        {announcement}{' '}
+        <a href={STATUS_PAGE} className="whitespace-nowrap underline underline-offset-[3px] hover:text-brand">
+          {t.link}
+        </a>
+      </p>
+      <button
+        type="button"
+        onClick={dismiss}
+        aria-label={t.close}
+        className="-my-2 -mr-3 grid size-11 shrink-0 cursor-pointer place-items-center rounded-lg border-0 bg-transparent text-mute transition-colors hover:text-ink"
+      >
+        <span aria-hidden="true">✕</span>
+      </button>
+    </div>
+  );
+}
