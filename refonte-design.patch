diff -ruN a/src/components/ThemeToggle.tsx b/src/components/ThemeToggle.tsx
--- a/src/components/ThemeToggle.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/ThemeToggle.tsx	2026-11-24 22:31:00.818399223 +0000
@@ -0,0 +1,53 @@
+'use client';
+
+import { useEffect } from 'react';
+
+export default function ThemeToggle({ locale }: { locale: 'fr' | 'en' }) {
+  // Tant que la personne n'a pas choisi, on suit les changements de thème du système
+  useEffect(() => {
+    const query = window.matchMedia('(prefers-color-scheme: light)');
+    const onChange = () => {
+      try {
+        if (localStorage.getItem('theme')) return;
+      } catch {
+        /* ignore */
+      }
+      document.documentElement.dataset.theme = query.matches ? 'light' : 'dark';
+    };
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+
+  function toggle() {
+    const root = document.documentElement;
+    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
+    root.dataset.theme = next;
+    try {
+      localStorage.setItem('theme', next);
+    } catch {
+      /* ignore */
+    }
+  }
+
+  const label = locale === 'fr' ? 'Changer de thème (clair / sombre)' : 'Switch theme (light / dark)';
+
+  return (
+    <button
+      type="button"
+      onClick={toggle}
+      aria-label={label}
+      title={label}
